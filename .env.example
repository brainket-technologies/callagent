# ==============================================================================
# VOXERA AI — BRAND & PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local to customize your brand name & settings.
# ==============================================================================

NEXT_PUBLIC_APP_NAME="Voxera AI"
NEXT_PUBLIC_APP_SHORT_NAME="Voxera"
NEXT_PUBLIC_APP_TAGLINE="Autonomous Enterprise Voice AI & Telephony Cloud"
NEXT_PUBLIC_COMPANY_NAME="Voxera Technologies Inc."
NEXT_PUBLIC_SUPPORT_EMAIL="support@voxera.ai"
NEXT_PUBLIC_ADMIN_EMAIL="admin@voxera.ai"

NEXT_PUBLIC_DEFAULT_CURRENCY="₹"
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE="INR"
NEXT_PUBLIC_RATE_PER_MINUTE="10.00"
NEXT_PUBLIC_MIN_CALL_BALANCE="10.00"

NEXT_PUBLIC_SDK_PACKAGE="@voxera/voice-sdk"
NEXT_PUBLIC_SDK_CDN_URL="https://cdn.voxera.ai/sdk/v1/widget.js"
NEXT_PUBLIC_PYTHON_SDK="voxera-stt"

# Centralized Theme & Colors (HackerRank Emerald Green & Clean White Light Mode)
NEXT_PUBLIC_THEME_MODE="light"
NEXT_PUBLIC_THEME_BG="#FFFFFF"
NEXT_PUBLIC_THEME_CANVAS="#F8FAFC"
NEXT_PUBLIC_THEME_BORDER="#E2E8F0"
NEXT_PUBLIC_THEME_PRIMARY="#11E97F"
NEXT_PUBLIC_THEME_PRIMARY_HOVER="#0ED071"
NEXT_PUBLIC_THEME_PRIMARY_TEXT="#0A0E1A"
NEXT_PUBLIC_THEME_ACCENT="#11E97F"
